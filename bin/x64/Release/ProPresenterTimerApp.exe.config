<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
	<!--ProPresenter/Resolume-->
	<add key="MainScreenUses" value="Resolume" />
    <add key="MainScreenText" value="Center Screen Video Countdown..." />
    <add key="MainScreenIPAddress" value="http://192.168.1.105:8091" />
	<!--ProPresenter/Resolume-->
	<add key="SideScreenUses" value="ProPresenter" />
	<add key="SideScreenText" value="Side Screen Video Countdown..." />
    <add key="SideScreenIPAddress" value="http://192.168.1.105:1781" />
    <add key="TimeOut" value="1000" />
  </appSettings>
  <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>